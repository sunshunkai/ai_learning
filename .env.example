# 复制此文件为 .env 并填入你的真实 Key（.env 已被 .gitignore 忽略，不会提交）
# 用法：脚本里 import 共享的 tools/load_env，会自动读取本文件。

# Anthropic / Claude（langchain 对接 claude 也用这个）
# 使用 DeepSeek 的 Anthropic 兼容接口时，这里填 DeepSeek Key
ANTHROPIC_API_KEY=sk-你的key

# 官方端点是 https://api.anthropic.com；DeepSeek Anthropic 兼容端点是：
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# LangChain demo 使用 DeepSeek 的 OpenAI 兼容端点
DEEPSEEK_API_KEY=sk-你的deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI（如果切换到 openai 模型时使用）
# OPENAI_API_KEY=sk-你的key
